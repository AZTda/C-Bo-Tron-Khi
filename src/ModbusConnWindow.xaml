<Window x:Class="Bo_Tron_Khi_CS.ModbusConnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modbus Connection Settings" 
        Height="360" Width="420"
        Background="#1E293B" Foreground="#F8FAFC"
        FontFamily="Segoe UI, Arial"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="26"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="28"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Controls Grid -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="MODBUS INTERFACE CONFIGURATION" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,12"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="30"/>
                <RowDefinition Height="Auto" MinHeight="30"/>
                <RowDefinition Height="Auto" MinHeight="30"/>
                <RowDefinition Height="Auto" MinHeight="30"/>
                <RowDefinition Height="Auto" MinHeight="30"/>
                <RowDefinition Height="Auto" MinHeight="30"/>
                <RowDefinition Height="Auto" MinHeight="30"/>
            </Grid.RowDefinitions>

            <!-- Port / Connection Type -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Serial Port / Sim:" VerticalAlignment="Center"/>
            <ComboBox x:Name="CbPorts" Grid.Row="0" Grid.Column="1" Height="26" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#475569"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Baud Rate:" VerticalAlignment="Center"/>
            <ComboBox x:Name="CbBaud" Grid.Row="1" Grid.Column="1" Height="26" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#475569">
                <ComboBoxItem Content="9600"/>
                <ComboBoxItem Content="19200" IsSelected="True"/>
                <ComboBoxItem Content="38400"/>
                <ComboBoxItem Content="115200"/>
            </ComboBox>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Parity:" VerticalAlignment="Center"/>
            <ComboBox x:Name="CbParity" Grid.Row="2" Grid.Column="1" Height="26" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#475569">
                <ComboBoxItem Content="Even (E)" IsSelected="True"/>
                <ComboBoxItem Content="Odd (O)"/>
                <ComboBoxItem Content="None (N)"/>
            </ComboBox>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Timeout (seconds):" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtTimeout" Grid.Row="3" Grid.Column="1" Text="0.5"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Mixing Board Slave ID:" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtMixingSlave" Grid.Row="4" Grid.Column="1" Text="2"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Omron E5CC Slave ID:" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtE5ccSlave" Grid.Row="5" Grid.Column="1" Text="1"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Use TCP connection:" VerticalAlignment="Center"/>
            <CheckBox x:Name="ChkUseTcp" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" Content="Enable TCP (Modbus TCP)" Foreground="#F8FAFC"/>
        </Grid>

        <!-- Save / Cancel -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save Settings" Click="OnSaveClick" Width="100" Margin="0,0,8,0"/>
            <Button Content="Cancel" Click="OnCancelClick" Width="80" Background="#475569"/>
        </StackPanel>
    </Grid>
</Window>
